{
  "name": "samantha-gkb-sdk-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Isolated runtime for verifying TheTowerSDK JSON knowledge exports before GKB ingestion.",
  "scripts": {
    "test:origin-schema": "node ../adapter/origin-schema-validation.mjs",
    "test:sdk-json-exports": "node ../adapter/sdk-json-export-smoke.mjs",
    "test:typescript-origin-parser": "node ../adapter/typescript-origin-parser.mjs",
    "test:origin-registry": "node ../adapter/origin-registry-validator.mjs",
    "test:sdk-claim-staging": "node ../tests/sdk-claim-staging.test.mjs",
    "test:unique-modules": "node ../tests/unique-modules-catalog.test.mjs",
    "test:claim-schema": "node ../tests/claim-schema.test.mjs",
    "test:sdk-public-exports": "node ../adapter/sdk-public-exports-smoke.mjs",
    "inspect:sdk-knowledge-shape": "node ../adapter/sdk-knowledge-shape-inspector.mjs",
    "inspect:sdk-data-catalogs": "node ../adapter/sdk-data-catalog-shape-inspector.mjs"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "thetowersdk": "0.14.1"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samantha.invalid/gkb/schema/sdk-contradiction-staging.schema.json",
  "title": "Samantha GKB SDK Contradiction Staging Record",
  "description": "Preserves SDK contradiction analysis without adopting its likelyValue as a factual winner.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stagingVersion",
    "stagingId",
    "recordKind",
    "sourceContradictionIndex",
    "sourceSubject",
    "sourcePredicate",
    "sourceLikelyValue",
    "sourceClaims",
    "sourceClaimCount",
    "sourceCrossSource",
    "likelyValueTreatment",
    "conflictStatus",
    "verificationStatus",
    "reviewStatus",
    "provenance",
    "sourceRecord",
    "limitations"
  ],
  "properties": {
    "stagingVersion": {
      "const": "1.0.0"
    },
    "stagingId": {
      "type": "string",
      "minLength": 1
    },
    "recordKind": {
      "const": "SDK_CONTRADICTION_ENVELOPE"
    },
    "sourceContradictionIndex": {
      "type": "integer",
      "minimum": 0
    },
    "sourceSubject": {},
    "sourcePredicate": {},
    "sourceLikelyValue": {},
    "sourceClaims": {
      "type": "array",
      "items": {}
    },
    "sourceClaimCount": {
      "type": "integer",
      "minimum": 0
    },
    "sourceCrossSource": {},
    "likelyValueTreatment": {
      "const": "SDK_HINT_ONLY_NOT_FACTUAL_WINNER"
    },
    "conflictStatus": {
      "const": "UNRESOLVED"
    },
    "verificationStatus": {
      "const": "EXTERNAL-UNVERIFIED"
    },
    "reviewStatus": {
      "const": "PENDING_REVIEW"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "sourceName",
        "sourceReference",
        "sdkPackage",
        "sdkVersion",
        "registryVersion",
        "sdkGraphVersion",
        "sdkSchemaVersion",
        "sdkGraphGeneratedFor",
        "retrievedAt",
        "rawOrigins",
        "originMappingStatus"
      ],
      "properties": {
        "sourceId": {
          "const": "sdk-knowledge-graph"
        },
        "sourceName": {
          "const": "TheTowerSDK Knowledge Graph"
        },
        "sourceReference": {
          "type": "string",
          "minLength": 1
        },
        "sdkPackage": {
          "const": "thetowersdk"
        },
        "sdkVersion": {
          "type": "string",
          "minLength": 1
        },
        "registryVersion": {
          "type": "string",
          "minLength": 1
        },
        "sdkGraphVersion": {
          "type": "integer"
        },
        "sdkSchemaVersion": {
          "type": "integer"
        },
        "sdkGraphGeneratedFor": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "retrievedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "rawOrigins": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "value"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "value": {}
            }
          }
        },
        "originMappingStatus": {
          "enum": [
            "UNMAPPED_REQUIRES_REVIEW",
            "UNRESOLVED",
            "INVALID_OR_MISSING"
          ]
        }
      }
    },
    "sourceRecord": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samantha.invalid/gkb/schema/sdk-assertion-staging.schema.json",
  "title": "Samantha GKB SDK Assertion Staging Record",
  "description": "One source-preserving review envelope per SDK graph assertion. This is not a canonical GKB claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stagingVersion",
    "stagingId",
    "recordKind",
    "sourceNodeStagingId",
    "sourceNodeId",
    "sourceAssertionIndex",
    "subject",
    "predicate",
    "value",
    "claimPreview",
    "classificationCandidate",
    "sourceNodeClaimType",
    "sourceVerification",
    "sourceVerificationPresent",
    "sourceNodeVerification",
    "verificationStatus",
    "reviewStatus",
    "provenance",
    "sourceRecord",
    "limitations"
  ],
  "properties": {
    "stagingVersion": {
      "const": "1.0.0"
    },
    "stagingId": {
      "type": "string",
      "minLength": 1
    },
    "recordKind": {
      "const": "SDK_GRAPH_ASSERTION_ENVELOPE"
    },
    "sourceNodeStagingId": {
      "type": "string",
      "minLength": 1
    },
    "sourceNodeId": {
      "type": "string",
      "minLength": 1
    },
    "sourceAssertionIndex": {
      "type": "integer",
      "minimum": 0
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "predicate": {
      "type": "string",
      "minLength": 1
    },
    "value": {},
    "claimPreview": {
      "type": "string",
      "minLength": 1
    },
    "classificationCandidate": {
      "enum": [
        "OBJECTIVE",
        "SENTIMENT",
        null
      ]
    },
    "sourceNodeClaimType": {},
    "sourceVerification": {},
    "sourceVerificationPresent": {
      "type": "boolean"
    },
    "sourceNodeVerification": {},
    "verificationStatus": {
      "const": "EXTERNAL-UNVERIFIED"
    },
    "reviewStatus": {
      "const": "PENDING_REVIEW"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "sourceName",
        "sourceReference",
        "sdkPackage",
        "sdkVersion",
        "registryVersion",
        "sdkGraphVersion",
        "sdkSchemaVersion",
        "sdkGraphGeneratedFor",
        "registryGameVersion",
        "retrievedAt",
        "sdkSourceReference",
        "sdkReadAgainstVersion",
        "sdkVerifiedAt",
        "rawOrigin",
        "rawOrigins",
        "originMappingStatus"
      ],
      "properties": {
        "sourceId": {
          "const": "sdk-knowledge-graph"
        },
        "sourceName": {
          "const": "TheTowerSDK Knowledge Graph"
        },
        "sourceReference": {
          "type": "string",
          "minLength": 1
        },
        "sdkPackage": {
          "const": "thetowersdk"
        },
        "sdkVersion": {
          "type": "string",
          "minLength": 1
        },
        "registryVersion": {
          "type": "string",
          "minLength": 1
        },
        "sdkGraphVersion": {
          "type": [
            "integer",
            "string"
          ]
        },
        "sdkSchemaVersion": {
          "type": [
            "integer",
            "string"
          ]
        },
        "sdkGraphGeneratedFor": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "registryGameVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrievedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sdkSourceReference": {
          "type": [
            "string",
            "null"
          ]
        },
        "sdkReadAgainstVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "sdkVerifiedAt": {},
        "rawOrigin": {},
        "rawOrigins": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "value"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "value": {}
            }
          }
        },
        "originMappingStatus": {
          "enum": [
            "UNMAPPED_REQUIRES_REVIEW",
            "UNRESOLVED",
            "INVALID_OR_MISSING"
          ]
        }
      }
    },
    "sourceRecord": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}

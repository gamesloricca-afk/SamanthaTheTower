{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://samantha.invalid/gkb/schema/canonical-domain-registry.schema.json",
 "type":"object","required":["schemaVersion","policy","domains"],
 "properties":{"schemaVersion":{"const":1},"policy":{"type":"string","minLength":1},
 "domains":{"type":"array","minItems":1,"items":{"type":"object","required":["domainId","label"],
 "properties":{"domainId":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"label":{"type":"string","minLength":1}},
 "additionalProperties":false}}},
 "additionalProperties":false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samantha.invalid/gkb/schema/sdk-domain-catalog-staging.schema.json",
  "title": "Samantha GKB SDK Domain Catalog Staging",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "source",
    "catalogs",
    "policy",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "generatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "source": {
      "type": "object",
      "required": [
        "name",
        "sdkPackage",
        "sdkVersion",
        "sdkGameVersion",
        "retrievedAt",
        "classification",
        "verificationStatus",
        "note"
      ],
      "properties": {
        "name": {
          "const": "TheTowerSDK"
        },
        "sdkPackage": {
          "const": "thetowersdk"
        },
        "sdkVersion": {
          "type": "string"
        },
        "sdkGameVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrievedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "classification": {
          "const": "OBJECTIVE"
        },
        "verificationStatus": {
          "const": "EXTERNAL-UNVERIFIED"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "catalogs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "domain",
          "exportName",
          "sourceRef",
          "recordCount",
          "observedRecordKeys",
          "records"
        ],
        "properties": {
          "domain": {
            "type": "string"
          },
          "exportName": {
            "type": "string"
          },
          "sourceRef": {
            "type": "string"
          },
          "recordCount": {
            "type": "integer",
            "minimum": 0
          },
          "observedRecordKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "sourceIndex",
                "rawRecord"
              ],
              "properties": {
                "sourceIndex": {
                  "type": "integer",
                  "minimum": 0
                },
                "rawRecord": {}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "rawRecordsPreserved",
        "sourceOrderPreserved",
        "unknownFieldsPreserved",
        "recordDeduplication",
        "identifierGeneration",
        "normalizationPerformed",
        "canonicalClaimsCreated",
        "canonicalImportPerformed"
      ],
      "properties": {
        "rawRecordsPreserved": {
          "const": true
        },
        "sourceOrderPreserved": {
          "const": true
        },
        "unknownFieldsPreserved": {
          "const": true
        },
        "recordDeduplication": {
          "const": false
        },
        "identifierGeneration": {
          "const": false
        },
        "normalizationPerformed": {
          "const": false
        },
        "canonicalClaimsCreated": {
          "const": false
        },
        "canonicalImportPerformed": {
          "const": false
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
